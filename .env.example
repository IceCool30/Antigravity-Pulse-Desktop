# ── Antigravity Pulse Desktop environment ─────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored and never committed.
# The Firebase Web API key is a public client identifier, not a secret.
# The Google OAuth desktop client secret is confidential-in-name only: Google's
# token endpoint requires it even with PKCE, so it is compiled into the installed
# app. Keep .env out of git and rotate the client if a build is shared broadly.

# Firebase project gen-lang-client-0437586304 (Web App: Antigravity Pulse Desktop)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Exact named Firestore database shared with Antigravity Pulse Android
VITE_FIREBASE_DATABASE_ID=

# Google OAuth "Desktop" client used for system-browser loopback + PKCE
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
