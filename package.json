{
  "name": "antigravity-pulse-desktop",
  "version": "1.0.3",
  "description": "Antigravity Pulse Desktop — an OLED workspace cockpit for AI and engineering consoles, with a secure phone companion bridge.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Solomon Bukie",
    "email": "solomonogarbukie@gmail.com"
  },
  "homepage": "https://github.com/IceCool30/Antigravity-Pulse-Desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "dist:win": "npm run build && electron-builder --win nsis zip",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "app-builder-lib": {
      "minimatch": "11.0.1"
    }
  }
}
